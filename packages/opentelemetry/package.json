{
  "name": "@orpc-agent/opentelemetry",
  "version": "0.3.0",
  "description": "OpenTelemetry TracingAdapter for oRPC Agent runtimes. Independent community project, not affiliated with or endorsed by the oRPC maintainers.",
  "license": "MIT",
  "author": "Paolo Barbato",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "prepublishOnly": "node ../../scripts/copy-license.cjs"
  },
  "dependencies": {
    "@orpc-agent/core": "workspace:^"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/context-async-hooks": "^2.10.0",
    "@opentelemetry/sdk-trace-base": "^2.0.0",
    "@orpc/server": "^1.14.10",
    "@types/node": "^24.13.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Wiseair-srl/orpc-agent.git",
    "directory": "packages/opentelemetry"
  },
  "homepage": "https://github.com/Wiseair-srl/orpc-agent/tree/main/packages/opentelemetry",
  "bugs": {
    "url": "https://github.com/Wiseair-srl/orpc-agent/issues"
  },
