# OpenRouter API key — enables the AI assistant (https://openrouter.ai/keys).
# Without it the board still works; chat is disabled with setup instructions.
OPENROUTER_API_KEY=

# Any OpenRouter model slug. The integration is model-agnostic.
# Examples: anthropic/claude-sonnet-4.5 · openai/gpt-4o-mini · google/gemini-2.5-flash
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
